; SPDX-License-Identifier: MIT
;
; GudDisplay.inf -- IddCx driver for a Generic USB Display device.
;
; This installs under the Display setup class onto a USB PDO. That combination
; looks odd and is correct: the setup class describes what the device is to the
; user, not how it is enumerated, and it is how every USB display adapter is
; installed. Installing it under USBDevice instead gets a driver that loads and
; a monitor that never appears in Display Settings.
;
; UmdfDispatcher = WinUsb is the line that matters. It puts winusb.sys
; underneath the UMDF host, which is what makes WdfUsbTargetDeviceCreate work
; from a user-mode driver. Without it the driver loads and every USB call
; fails.
;
; Two values below must be checked against the WDK actually installed, because
; both are version-specific and a wrong one fails at install time with a
; message that does not name the cause:
;
;   UmdfExtensions      the IddCx version, e.g. IddCx0102, IddCx0104, IddCx0105
;   UmdfLibraryVersion  the UMDF2 version shipped with that WDK
;
; `certutil -dump` the WDK's IddCx redist, or copy both lines from the
; IndirectDisplay sample INF that ships with the WDK, which is guaranteed to
; match its own headers.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
CatalogFile = GudDisplay.cat
; Must outrank GudProbeWinUsb.inf, which matches the same hardware ID. With an
; identical DriverVer the incumbent binding wins and the device stays on
; WinUSB, so this carries the higher version -- ranking compares the date
; first, then the version, and equal dates fall through to the version.
;
; The date deliberately is not "today": inf2cat rejects a postdated DriverVer
; against UTC, so a date set after local midnight in a positive offset fails
; signability with 22.9.7 while looking perfectly reasonable.
DriverVer   = 08/12/2026,1.1.0.0
PnpLockdown = 1

[Manufacturer]
%Provider% = Devices, NTamd64, NTarm64

[Devices.NTamd64]
%DeviceName% = GudDisplay_Install, USB\VID_1D50&PID_614D
%DeviceName% = GudDisplay_Install, USB\VID_1D50&PID_614D&MI_00

[Devices.NTarm64]
%DeviceName% = GudDisplay_Install, USB\VID_1D50&PID_614D
%DeviceName% = GudDisplay_Install, USB\VID_1D50&PID_614D&MI_00

; The &MI_00 form is there for the day the gadget grows a second function and
; Windows puts usbccgp in front of it. With one interface today only the first
; matches, and listing both costs nothing.

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
GudDisplay.dll = 1

; 12,UMDF is drivers\umdf, which is where a UMDF2 binary goes and where
; ServiceBinary below points. 13 is the driver store, which installs without
; complaint and then cannot be loaded.
[DestinationDirs]
UMDriverCopy = 12,UMDF

; No `Include = WUDFRD.inf` / `Needs = WUDFRD.NT` here.
;
; That is the form Microsoft's own documentation shows, and WUDFRD.inf does not
; exist on Windows 10 19045 -- only the WUDFRd.sys binary and its service do.
; The include silently fails to resolve, every section that depends on it is
; skipped, and the install ends as 0x0000000D ERROR_INVALID_DATA reported to
; pnputil as the far less helpful 0x57 "the parameter is incorrect". The
; setupapi.dev.log line is the only place it is named:
;
;     Could not include WUDFRD.inf under [GudDisplay_Install.NT].
;
; Registering the reflector service explicitly is what every working UMDF2 INF
; in this machine's driver store does.
[GudDisplay_Install.NT]
CopyFiles = UMDriverCopy

[GudDisplay_Install.NT.Services]
AddService = WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName   = "Windows Driver Foundation - User-mode Driver Framework Reflector"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WUDFRd.sys

[GudDisplay_Install.NT.Wdf]
UmdfService              = GudDisplay, GudDisplay_Install_Service
UmdfServiceOrder         = GudDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy     = AllowNullAndUnknownFileObjects
UmdfDeviceObjectPolicy   = AllowNullAndUnknownFileObjects

[GudDisplay_Install_Service]
; 2.31, not 2.33. The WDK ships headers and stubs for both, so 2.33 builds and
; installs cleanly and then fails to load: UMDF 2.33 is a Windows 11 framework
; and this is Windows 10 19045, whose WUDFx02000.dll is on the 19041 branch and
; provides at most 2.31. The symptom is a device with problem 31 and, only in
; the DriverFrameworks-UserMode/Operational channel which ships disabled,
; "The UMDF Host failed to load the driver at level 0" with 0xD000000D.
;
; Raise this only alongside the minimum OS the package is meant to install on.
UmdfLibraryVersion = 2.31.0
ServiceBinary      = %12%\UMDF\GudDisplay.dll
UmdfExtensions     = IddCx0102
; Whether UMDF accepts this line together with UmdfExtensions = IddCx is not
; yet established. Nothing else pairs a WinUsb dispatcher with an IddCx
; extension, so there is no prior art saying the combination works, and it is
; one of three candidates for the DriverEntry failure that is still open --
; the others being this driver's own WDF setup and IddCx declining a USB PDO.
; Removing it temporarily is a one-line experiment worth running, but it was
; not conclusive when tried: the reading came back contaminated by a pending
; reboot. Separate the three with the minimal driver in BRINGUP step 4 first.
UmdfDispatcher     = WinUsb

[UMDriverCopy]
GudDisplay.dll

[Strings]
Provider   = "gud-windows"
DeviceName = "Generic USB Display"
DiskName   = "GUD Display Installation Disk"
